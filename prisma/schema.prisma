// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageType {
  CAR_RENTAL
  TOUR_PACKAGE
  FULL_DAY_TRIP
  CUSTOM_PRICING
}

enum ArmadaStatus {
  READY
  BOOKED
  ON_TRIP
  MAINTENANCE
}

enum DriverStatus {
  READY
  BOOKED
  ON_TRIP
  OFF_DUTY
}

enum PaymentStatus {
  UNPAID
  DOWN_PAYMENT
  PAID
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PENDING_EDIT
}

enum ExpenseApprovalStatus {
  APPROVED
  PENDING_EDIT
  PENDING_DELETE
  REJECTED
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  COMPLETE
  SUBMIT_APPROVAL
  APPROVE
  REJECT
  REQUEST_EDIT
  REQUEST_DELETE
  APPROVE_EDIT
  APPROVE_DELETE
  ACCESS_DENIED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum ExpenseCategory {
  LISTRIK
  INTERNET
  PAKET_DATA
  KONSUMSI
  GAJI_STAF_OPERASIONAL
  GAJI_STAF_ADMIN
  INSENTIF_BONUS
  PAJAK
  ALAT_TULIS_KANTOR
  KOMPUTER_SUPPLIES
  OPERASIONAL_LAINNYA
  BBM
  PERAWATAN_ARMADA
  GAJI_SOPIR
  LAINNYA
}

// Modul 2.5: Manajemen Paket Jasa
model ServicePackage {
  id                String      @id @default(uuid())
  name              String
  type              PackageType
  description       String?
  includes          String[]
  excludes          String[]
  isCustomizable    Boolean     @default(false)
  customizableItems String[]

  // Fields for CAR_RENTAL type
  price         Int?
  durationHours Int?
  overtimeRate  Int?

  // Fields for TOUR_PACKAGE type
  durationDays   Int?
  durationNights Int?
  hotelTiers     HotelTier[]
  itineraries    ItineraryDay[]

  // Relasi: Satu paket bisa digunakan di banyak transaksi
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_packages")
}

model HotelTier {
  id               String            @id @default(uuid())
  starRating       Int
  servicePackageId String
  servicePackage   ServicePackage    @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)
  hotels           Hotel[]
  priceRanges      HotelPriceRange[]
  transactions     Transaction[] // Relasi balik dari Transaction

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hotel_tiers")
}

model Hotel {
  id          String    @id @default(uuid())
  name        String
  hotelTierId String
  hotelTier   HotelTier @relation(fields: [hotelTierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hotels")
}

model HotelPriceRange {
  id          String    @id @default(uuid())
  minPax      Int
  maxPax      Int
  price       Int
  hotelTierId String
  hotelTier   HotelTier @relation(fields: [hotelTierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hotel_price_ranges")
}

model ItineraryDay {
  id               String         @id @default(uuid())
  day              Int
  title            String
  description      String?
  servicePackageId String
  servicePackage   ServicePackage @relation(fields: [servicePackageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("itinerary_days")
}

// Modul 3: Manajemen Armada
model Armada {
  id            String       @id @default(uuid())
  license_plate String       @unique
  brand         String
  model         String
  vehicle_type  String? // Tipe kendaraan (MPV, SUV, Sedan, dll)
  year          Int? // Tahun pembuatan
  color         String? // Warna kendaraan
  capacity      Int? // Kapasitas penumpang
  status        ArmadaStatus @default(READY)

  // Relasi: Satu armada bisa ada di banyak transaksi
  transactions Transaction[]
  // Relasi: Satu armada bisa memiliki banyak catatan pengeluaran (servis, dll)
  expenses     Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("armadas")
}

// Modul 4: Manajemen Sopir
model Driver {
  id           String       @id @default(uuid())
  driver_name  String
  nik          String?
  phone_number String
  address      String?
  status       DriverStatus @default(READY)

  // Relasi: Satu sopir bisa ditugaskan di banyak transaksi
  transactions Transaction[]
  expenses     Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("drivers")
}

// 4. Model Database (Data Transaksional - Milik Developer A)

// Modul 5: Manajemen Pengeluaran Operasional
model Expense {
  id           String          @id @default(uuid())
  date         DateTime        @db.Date
  paymentMonth DateTime?       @db.Date // Bulan untuk periode pembayaran
  category     ExpenseCategory // Kategori pengeluaran menggunakan enum
  description  String
  amount       Int

  // File attachments
  attachments ExpenseAttachment[]

  // Relasi: Pengeluaran ini (opsional) terkait dengan armada mana
  armadaId String?
  armada   Armada? @relation(fields: [armadaId], references: [id], onDelete: SetNull)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  staffId String?
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  namaPenerima String? // Nama penerima insentif/bonus (untuk kategori INSENTIF_BONUS)

  // Approval workflow fields
  approval_status       ExpenseApprovalStatus @default(APPROVED) // Default APPROVED untuk backward compatibility
  edit_request_reason   String? // Alasan operator request edit
  delete_request_reason String? // Alasan operator request delete
  rejection_reason      String? // Alasan admin reject
  original_data         Json? // Backup data sebelum edit (untuk restore jika rejected)
  proposed_changes      Json? // Perubahan yang diusulkan operator (untuk review admin)

  // User relations untuk approval workflow
  requested_by_id String?
  requested_by    User?   @relation("ExpenseRequestedBy", fields: [requested_by_id], references: [id], onDelete: SetNull)

  approved_by_id String?
  approved_by    User?   @relation("ExpenseApprovedBy", fields: [approved_by_id], references: [id], onDelete: SetNull)

  requested_at DateTime?
  approved_at  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([armadaId])
  @@index([driverId])
  @@index([staffId])
  @@index([requested_by_id])
  @@index([approved_by_id])
  @@map("expenses")
}

// Model untuk menyimpan attachment pengeluaran
model ExpenseAttachment {
  id        String  @id @default(uuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  fileName String // Original file name
  filePath String // Path in MinIO
  fileSize Int // File size in bytes
  mimeType String // MIME type

  createdAt DateTime @default(now())

  @@index([expenseId])
  @@map("expense_attachments")
}

// Modul 2: Manajemen Transaksi
model Transaction {
  id                String   @id @default(uuid())
  invoice_code      String   @unique
  customer_name     String
  customer_phone    String
  booking_date      DateTime @db.Date
  checkout_datetime DateTime // Waktu mobil keluar
  checkin_datetime  DateTime // Waktu mobil kembali (estimasi)

  // Data Keuangan
  all_in_rate            Int // Tarif sewa
  overtime_rate_per_hour Int
  dp_amount              Int? // Jumlah Down Payment yang diterima (opsional)
  payment_status         PaymentStatus @default(UNPAID)

  // Data Aktual (diisi saat transaksi selesai)
  actual_checkin_datetime DateTime? // Waktu mobil kembali yang sebenarnya
  actual_overtime_cost    Int? // Biaya overtime yang dikenakan

  // Data Tambahan untuk Paket Wisata
  hotel_name   String? // Nama hotel yang dipilih (opsional, untuk TOUR_PACKAGE)
  pax_count    Int? // Jumlah penumpang/pax (opsional, untuk TOUR_PACKAGE)
  custom_price Int? // Harga custom untuk paket CUSTOM_PRICING (opsional)

  // Relasi ke HotelTier yang dipilih (opsional, untuk TOUR_PACKAGE)
  hotel_tier_id String?
  hotelTier     HotelTier? @relation(fields: [hotel_tier_id], references: [id], onDelete: SetNull)

  // Approval Workflow
  approval_status  ApprovalStatus @default(DRAFT)
  submitted_at     DateTime? // Waktu submit untuk persetujuan
  submitted_by_id  String?
  submitted_by     User?     @relation("TransactionSubmittedBy", fields: [submitted_by_id], references: [id], onDelete: SetNull)
  approved_at      DateTime? // Waktu disetujui
  approved_by_id   String?
  approved_by      User?     @relation("TransactionApprovedBy", fields: [approved_by_id], references: [id], onDelete: SetNull)
  rejected_at      DateTime? // Waktu ditolak
  rejected_by_id   String?
  rejected_by      User?     @relation("TransactionRejectedBy", fields: [rejected_by_id], references: [id], onDelete: SetNull)
  rejection_reason String? // Alasan penolakan

  // Edit Request Workflow
  edit_request_reason String? // Alasan operator request edit
  original_data       Json? // Backup data sebelum edit (untuk restore jika rejected)
  proposed_changes    Json? // Perubahan yang diusulkan operator (untuk review admin)
  requested_by_id     String?
  requested_by        User?     @relation("TransactionRequestedBy", fields: [requested_by_id], references: [id], onDelete: SetNull)
  requested_at        DateTime? // Waktu request edit

  // --- Relasi (Foreign Keys) ---

  // Relasi: Transaksi ini (opsional) menggunakan paket apa
  packageId String?
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  // Relasi: Transaksi ini (wajib) menggunakan armada apa
  // onDelete: Restrict -> Mencegah armada dihapus jika masih punya riwayat transaksi
  armadaId String
  armada   Armada @relation(fields: [armadaId], references: [id], onDelete: Restrict)

  // Relasi: Transaksi ini (wajib) menggunakan sopir siapa
  // onDelete: Restrict -> Mencegah sopir dihapus jika masih punya riwayat transaksi
  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submitted_by_id])
  @@index([approved_by_id])
  @@index([rejected_by_id])
  @@index([requested_by_id])
  @@map("transactions")
}

// Modul 6: Authentication & Authorization
model User {
  id          String    @id @default(uuid())
  email       String    @unique
  username    String    @unique
  password    String // Hashed with bcrypt
  name        String
  role        UserRole  @default(OPERATOR)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  lastLoginIp String?

  // Password reset
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Account security
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Relasi
  sessions  Session[]
  auditLogs AuditLog[]

  // Relasi untuk expense approval workflow
  expensesRequested Expense[] @relation("ExpenseRequestedBy")
  expensesApproved  Expense[] @relation("ExpenseApprovedBy")

  // Relasi untuk transaction approval workflow
  transactionsSubmitted Transaction[] @relation("TransactionSubmittedBy")
  transactionsApproved  Transaction[] @relation("TransactionApprovedBy")
  transactionsRejected  Transaction[] @relation("TransactionRejectedBy")
  transactionsRequested Transaction[] @relation("TransactionRequestedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// Modul 8: Manajemen Staff (untuk pembayaran gaji)
model Staff {
  id           String  @id @default(uuid())
  staff_name   String
  nik          String? @unique // Nomor Induk Karyawan
  position     String // Posisi bebas, dapat ditambahkan secara dinamis
  phone_number String
  email        String?
  address      String?

  // Informasi Gaji
  salary_amount Int // Gaji pokok per bulan
  allowances    Int? @default(0) // Tunjangan

  // Informasi Bank untuk transfer gaji
  bank_name      String?
  bank_account   String?
  account_holder String?

  // Status & Tanggal
  status      StaffStatus @default(ACTIVE)
  join_date   DateTime    @db.Date
  resign_date DateTime?   @db.Date

  // Notes
  notes    String?
  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff")
}

// Modul 7: Audit Logging untuk Compliance
model AuditLog {
  id          String      @id @default(uuid())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  resource    String // e.g., "Transaction", "Armada", "User"
  resourceId  String? // ID of the affected resource
  description String // Human-readable description
  metadata    Json? // Additional data (before/after values, etc.)
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}
