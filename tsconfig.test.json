{
  "extends": "./jsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@test-utils/*": ["./test-utils/*"],
      "@test-config/*": ["./test-config/*"]
    }
  },
  "include": [
    "test-suites/**/*",
    "test-utils/**/*",
    "test-config/**/*"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "test-reports"
  ]
}
